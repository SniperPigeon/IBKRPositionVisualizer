// IBKR 交易回看 — Workers + Static Assets
//   npm install
//   npm run dev       # 本地：http://localhost:8787（行情从本机出口拉）
//   npm run deploy    # 部署（第一次需要 npx wrangler login）
{
	"name": "ibkr-trade-viz",
	"main": "worker/index.js",
	"compatibility_date": "2026-11-01",
	// 只通过自定义域名提供服务；workers.dev 地址会暴露账号子域名，关闭
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "ibtradeviz.sniperpigeon.com", "custom_domain": true }],

	// 页面和前端脚本直接作为静态资源返回，只有 /api/* 进 Worker
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},

	// Workers Caching：按响应的 Cache-Control 缓存 /api/chart，命中时 Worker 不运行。
	// cross_version_cache：每次部署（CI 在每次推送 main 后自动部署）不清空缓存，历史块不必重拉。
	// 响应格式变化时，改 public/lib/chunks.js 的 CHUNK_VERSION（URL 里的 v=），旧缓存自然失效。
	"cache": { "enabled": true, "cross_version_cache": true },

	"durable_objects": {
		"bindings": [{ "name": "GATE", "class_name": "YahooGate" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["YahooGate"] }],

	// 限流参数（只作用于缓存未命中、需要回源 Yahoo 的请求）
	"vars": {
		"GATE_RATE": "3",
		"GATE_BURST": "30",
		"GATE_DAILY": "4000",
		"IP_RATE": "0.5",
		"IP_BURST": "15"
	},

	"observability": { "enabled": true }
}
